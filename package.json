{
  "name": "Auto Car Reminder",
  "version": "1.0.0",
  "description": "Recordatorio sobre mantenimientos a tus vehiculos y control de combustible",
  "main": "index.js",
  "scripts": {
    "start": "node build/index.js",
    "dev": "ts-node-dev --files src/index.ts --watch",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "deploy": "npm run build && firebase deploy --only functions,apphosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:api": "npm run build && firebase deploy --only apphosting"
  },
  "author": "Victor Torres tikodev",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^10.1.7",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.13",
    "@types/express": "4.17.15",
    "@types/jsonwebtoken": "9.0.1",
    "@types/node": "18.11.18",
    "@types/nodemailer": "^8.0.2",
    "@types/typescript": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^5.48.2",
    "@typescript-eslint/parser": "^5.48.2",
    "eslint": "^8.32.0",
    "ts-node-dev": "2.0.0"
  }
}
